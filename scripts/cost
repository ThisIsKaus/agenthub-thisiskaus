#!/bin/zsh
L=~/AgentHub/logs/spend.jsonl
[[ -f $L ]] || { echo "no spend recorded yet"; exit 0 }
M=$(date +%Y-%m)
echo "Month-to-date ($M) — alert thresholds \$100 / \$250"
grep "\"ts\": \"$M" $L 2>/dev/null | jq -s '
  {total_usd: (map(.cost_usd)|add|.*10000|round/10000),
   requests: length,
   by_model: (group_by(.model)|map({model: .[0].model, usd: (map(.cost_usd)|add|.*10000|round/10000), n: length}))}'
