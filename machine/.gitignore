# `models/` was written for LM Studio's weight cache and silently swallowed source code:
# machine/models/scanner.py lived on one disk only, outside git and outside the CI guard that
# refuses deletions under machine/. Ignore the weights, not the directory.
models/*.gguf
models/*.safetensors
models/*.mlx
models/*.bin
!models/*.py
!models/*.sh
kb/
vault/
inbox/
state/
logs/
drafts/
digests/
*.db
*.jsonl
.env*
__pycache__/
*.pyc
.DS_Store
report/index.html
report/state-prev.json
report/state-history.jsonl
*.bak

# Golden eval sets are the learning artefact, not logs — always tracked
!evals/triage_set.jsonl
!evals/retrieval_set.jsonl

# kb-skills is its own repository, cloned here as the skill library
skills-lib/

# Golden sets are the learning artefact, not logs. *.jsonl swept them up twice.
!evals/intent_set.jsonl
!evals/retrieval_golden.jsonl
!contracts/*.json
